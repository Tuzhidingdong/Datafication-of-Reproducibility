{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/publication_package_manifest.schema.json",
  "title": "Publication Package Manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "run_id", "package_version", "writing_guide", "artifacts", "completeness"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string"},
    "run_id": {"type": "string"},
    "package_version": {"type": "string"},
    "created_at": {"type": "string"},
    "domain_profile": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "source_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
    "writing_guide": {"type": "string", "const": "README_FOR_WRITING_SKILL.md"},
    "writing_guide_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "type", "description", "status"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "type": {"type": "string"},
          "description": {"type": "string"},
          "status": {"enum": ["complete", "partial", "not_generated", "not_applicable", "requires_review"]},
          "sha256": {"type": "string"},
          "linked_record_ids": {"type": "array", "items": {"type": "string"}},
          "manuscript_sections": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "completeness": {
      "type": "object",
      "required": ["status", "unresolved_items"],
      "properties": {
        "status": {"enum": ["complete", "partial", "requires_review"]},
        "unresolved_items": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

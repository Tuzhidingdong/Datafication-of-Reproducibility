{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/v1_acceptance_record.schema.json",
  "title": "DOR V1.0 Controlled Scientific Acceptance Record",
  "type": "object",
  "required": [
    "schema_version",
    "acceptance_id",
    "project_id",
    "scope",
    "run_id",
    "run_manifest_sha256",
    "source_snapshot",
    "stages",
    "final_assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "acceptance_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "CONTROLLED_SINGLE_STUDY",
        "MULTI_STUDY_PILOT"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_snapshot": {
      "type": "object",
      "required": [
        "study_count",
        "study_ids",
        "artifacts"
      ],
      "properties": {
        "study_count": {
          "type": "integer",
          "minimum": 1
        },
        "study_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "role",
              "path",
              "sha256"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "PRIMARY_PAPER",
                  "SUPPLEMENTARY_INFORMATION",
                  "STRUCTURED_DATA",
                  "OTHER"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "status",
          "evidence",
          "limitations"
        ],
        "properties": {
          "stage_id": {
            "enum": [
              "source_selection",
              "source_integrity",
              "extraction_review",
              "semantic_mapping",
              "canonical_reconciliation",
              "cohort_feasibility",
              "modeling_validation",
              "publication_handoff"
            ]
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "artifact_id",
                "path",
                "sha256"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_applicable_reason": {
            "type": "string",
            "minLength": 1
          },
          "blocker_reason": {
            "type": "string",
            "minLength": 1
          },
          "decision_note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_APPLICABLE"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "not_applicable_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "FAIL",
                    "BLOCKED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "blocker_reason"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "final_assessment": {
      "type": "object",
      "required": [
        "decision",
        "assessed_by",
        "rationale",
        "blocking_issue_ids"
      ],
      "properties": {
        "decision": {
          "enum": [
            "NOT_ASSESSED",
            "PASS",
            "CONDITIONAL_PASS",
            "FAIL"
          ]
        },
        "assessed_by": {
          "type": "string",
          "minLength": 1
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "blocking_issue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "CONTROLLED_SINGLE_STUDY"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "source_snapshot": {
            "properties": {
              "study_count": {
                "const": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "final_assessment": {
            "properties": {
              "decision": {
                "const": "PASS"
              }
            },
            "required": [
              "decision"
            ]
          }
        },
        "required": [
          "final_assessment"
        ]
      },
      "then": {
        "properties": {
          "stages": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "MULTI_STUDY_PILOT"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "source_snapshot": {
            "properties": {
              "study_count": {
                "minimum": 2
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

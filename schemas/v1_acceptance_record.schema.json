{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/v1_acceptance_record.schema.json",
  "title": "DOR V1.0 Controlled Scientific Acceptance Record",
  "type": "object",
  "required": [
    "schema_version",
    "acceptance_id",
    "project_id",
    "scope",
    "run_id",
    "run_manifest_sha256",
    "source_snapshot",
    "stages",
    "final_assessment"
  ],
  "$defs": {
    "gateArtifactReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "acceptance_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "CONTROLLED_SINGLE_STUDY",
        "MULTI_STUDY_PILOT"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_snapshot": {
      "type": "object",
      "required": [
        "study_count",
        "study_ids",
        "artifacts"
      ],
      "properties": {
        "study_count": {
          "type": "integer",
          "minimum": 1
        },
        "study_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "role",
              "path",
              "sha256"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "PRIMARY_PAPER",
                  "SUPPLEMENTARY_INFORMATION",
                  "STRUCTURED_DATA",
                  "OTHER"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "status",
          "evidence",
          "limitations"
        ],
        "properties": {
          "stage_id": {
            "enum": [
              "source_selection",
              "source_integrity",
              "extraction_review",
              "semantic_mapping",
              "canonical_reconciliation",
              "cohort_feasibility",
              "modeling_validation",
              "publication_handoff"
            ]
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "artifact_id",
                "artifact_type",
                "path",
                "sha256"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "artifact_type": {
                  "enum": [
                    "source_selection_manifest",
                    "source_inventory",
                    "run_manifest",
                    "extraction_review_record",
                    "mapping_plan",
                    "canonical_bundle",
                    "reconciliation_report",
                    "cohort_report",
                    "split_manifest",
                    "model_report",
                    "modeling_run_manifest",
                    "publication_package_manifest",
                    "publication_integrity_report",
                    "model_artifact",
                    "reproducibility_evaluation",
                    "reproducibility_evaluation_manifest",
                    "reconciliation_decisions",
                    "modeling_task",
                    "modeling_cohort_manifest",
                    "modeling_cohort_csv"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_applicable_reason": {
            "type": "string",
            "minLength": 1
          },
          "blocker_reason": {
            "type": "string",
            "minLength": 1
          },
          "decision_note": {
            "type": "string"
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "review_rationale": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "check_id",
                "artifact_id",
                "json_pointer",
                "operator"
              ],
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "json_pointer": {
                  "type": "string"
                },
                "operator": {
                  "enum": [
                    "exists",
                    "equals",
                    "not_equals",
                    "gte",
                    "lte",
                    "non_empty",
                    "unique",
                    "contains"
                  ]
                },
                "expected": {}
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operator": {
                        "enum": [
                          "equals",
                          "not_equals",
                          "gte",
                          "lte",
                          "contains"
                        ]
                      }
                    },
                    "required": [
                      "operator"
                    ]
                  },
                  "then": {
                    "required": [
                      "expected"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_APPLICABLE"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "not_applicable_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "FAIL",
                    "BLOCKED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "blocker_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "BLOCKED",
                    "NOT_APPLICABLE"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reviewed_by",
                "reviewed_at",
                "review_rationale"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "BLOCKED",
                    "NOT_APPLICABLE"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reviewed_by",
                "reviewed_at",
                "review_rationale"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "final_assessment": {
      "type": "object",
      "required": [
        "decision",
        "assessed_by",
        "rationale",
        "blocking_issue_ids"
      ],
      "properties": {
        "decision": {
          "enum": [
            "NOT_ASSESSED",
            "PASS",
            "CONDITIONAL_PASS",
            "FAIL"
          ]
        },
        "assessed_by": {
          "type": "string",
          "minLength": 1
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "blocking_issue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "workflow_gate_ledger": {
      "type": "object",
      "description": "Exact approval-ledger snapshot required for final PASS; any later gate event invalidates this binding.",
      "required": [
        "path",
        "sha256",
        "gate_event_hashes",
        "gate_artifacts"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gate_artifacts": {
          "type": "object",
          "description": "Exact artifact references contained in each latest G0-G4 approval event.",
          "required": ["G0", "G1", "G2", "G3", "G4"],
          "properties": {
            "G0": {"$ref": "#/$defs/gateArtifactReferences"},
            "G1": {"$ref": "#/$defs/gateArtifactReferences"},
            "G2": {"$ref": "#/$defs/gateArtifactReferences"},
            "G3": {"$ref": "#/$defs/gateArtifactReferences"},
            "G4": {"$ref": "#/$defs/gateArtifactReferences"}
          },
          "additionalProperties": false
        },
        "gate_event_hashes": {
          "type": "object",
          "required": [
            "G0",
            "G1",
            "G2",
            "G3",
            "G4"
          ],
          "properties": {
            "G0": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "G1": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "G2": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "G3": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "G4": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "CONTROLLED_SINGLE_STUDY"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "source_snapshot": {
            "properties": {
              "study_count": {
                "const": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "final_assessment": {
            "properties": {
              "decision": {
                "const": "PASS"
              }
            },
            "required": [
              "decision"
            ]
          }
        },
        "required": [
          "final_assessment"
        ]
      },
      "then": {
        "properties": {
          "stages": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "MULTI_STUDY_PILOT"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "source_snapshot": {
            "properties": {
              "study_count": {
                "minimum": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "final_assessment": {
            "properties": {
              "decision": {
                "enum": [
                  "PASS",
                  "CONDITIONAL_PASS",
                  "FAIL"
                ]
              }
            },
            "required": [
              "decision"
            ]
          }
        },
        "required": [
          "final_assessment"
        ]
      },
      "then": {
        "properties": {
          "final_assessment": {
            "required": [
              "assessed_at"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/publication_package_plan.schema.json",
  "title": "Explicit publication package assembly plan",
  "type": "object",
  "required": ["schema_version", "project_id", "run_id", "package_version", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "domain_profile": {"type": "string"},
    "writing_guide_source": {"type": ["string", "null"]},
    "source_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "type", "description", "status"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "source_path": {"type": ["string", "null"]},
          "type": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "status": {"enum": ["complete", "partial", "not_generated", "not_applicable", "requires_review"]},
          "linked_record_ids": {"type": "array", "items": {"type": "string"}},
          "manuscript_sections": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

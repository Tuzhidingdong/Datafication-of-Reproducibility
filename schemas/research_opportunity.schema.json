{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/research_opportunity.schema.json",
  "title": "Research Opportunity",
  "type": "object",
  "required": [
    "schema_version",
    "opportunity_id",
    "scientific_question",
    "hypothesis",
    "supporting_signals",
    "data_feasibility",
    "identifiability",
    "confounding_risks",
    "proposed_methods",
    "novelty_status",
    "expected_scientific_contribution",
    "limitations",
    "recommendation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "scientific_question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "scientific_significance": {
      "type": "string"
    },
    "novelty_status": {
      "enum": [
        "not_assessed",
        "targeted_literature_review_pending",
        "potentially_novel_after_review",
        "not_novel_or_incremental",
        "uncertain"
      ]
    },
    "supporting_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_studies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_feasibility": {
      "type": "string"
    },
    "identifiability": {
      "type": "string"
    },
    "robustness_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confounding_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_scientific_contribution": {
      "type": "string"
    },
    "experimental_validation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "enum": [
        "priority_1",
        "priority_2",
        "priority_3",
        "reserve",
        "reject_pending_data"
      ]
    },
    "recommendation_rationale": {
      "type": "string"
    },
    "signal_type": {
      "type": "string",
      "minLength": 1
    },
    "analysis_family": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_definition": {
      "type": "string"
    },
    "timepoint": {
      "type": "string"
    },
    "outcome_unit": {
      "type": "string"
    },
    "condition_type": {
      "type": "string",
      "minLength": 1
    },
    "condition_unit": {
      "type": "string"
    },
    "level_a": {
      "type": "string"
    },
    "level_b": {
      "type": "string"
    },
    "condition_levels": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "independent_study_count": {
      "type": "integer",
      "minimum": 0
    },
    "effect_size": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence_interval_95": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "p_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "q_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "screen_status": {
      "enum": [
        "FDR_SCREEN_POSITIVE_REQUIRES_DOMAIN_REVIEW",
        "NOT_FDR_SCREEN_POSITIVE_REQUIRES_REVIEW",
        "DESCRIPTIVE_CANDIDATE_INSUFFICIENT_INDEPENDENT_STUDY_SUPPORT"
      ]
    },
    "semantic_status": {
      "type": "string"
    },
    "study_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "study_id"
        ],
        "properties": {
          "study_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "study_id"
        ],
        "properties": {
          "study_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_feasibility": {
      "type": "object",
      "properties": {
        "study_count": {
          "type": "integer",
          "minimum": 0
        },
        "system_count": {
          "type": "integer",
          "minimum": 0
        },
        "experiment_count": {
          "type": "integer",
          "minimum": 0
        },
        "observation_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "contrast_orientation": {
      "type": "string",
      "enum": [
        "NUMERIC_ASCENDING",
        "SERIALIZED_LABEL_ORDER"
      ]
    }
  },
  "additionalProperties": false
}

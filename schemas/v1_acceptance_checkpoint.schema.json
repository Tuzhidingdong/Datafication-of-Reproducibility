{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/v1_acceptance_checkpoint.schema.json",
  "title": "DOR V1.0 Detached Acceptance Checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_type",
    "acceptance",
    "record",
    "revision_ledger",
    "revision_snapshots",
    "upstream_ledgers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "checkpoint_type": {
      "const": "DOR_ACCEPTANCE_LEDGER_CHECKPOINT"
    },
    "acceptance": {
      "type": "object",
      "required": [
        "acceptance_id",
        "project_id",
        "run_id"
      ],
      "properties": {
        "acceptance_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "revision_ledger": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "event_count",
        "latest_event_hash",
        "latest_record_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "latest_event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "latest_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "revision_snapshots": {
      "type": "object",
      "required": [
        "directory",
        "items"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^revision-[0-9]{6}\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "upstream_ledgers": {
      "type": "object",
      "properties": {
        "workflow_gate_ledger": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "binding"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "binding": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "run_event_ledger": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "binding"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "binding": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

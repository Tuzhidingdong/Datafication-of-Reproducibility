{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/run_event.schema.json",
  "title": "DOR Run Event",
  "description": "One JSON object per line in run_events.jsonl. Event hashes and sequence are checked by the Runtime.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "recorded_at",
    "previous_event_hash",
    "event_type",
    "event_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_type": {
      "enum": [
        "RUN_INITIALIZED",
        "WORKER_AUTHORIZED",
        "STAGE_STATUS"
      ]
    },
    "stage_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "authorized_by": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "worker": {
      "type": "object"
    },
    "producer": {
      "type": "object"
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactSnapshot"
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactSnapshot"
      }
    },
    "permitted_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "kind"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "derived",
              "worker_staging"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_spec": {
      "type": [
        "object",
        "null"
      ]
    },
    "gate_approval": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "gate_id": {
          "enum": [
            "G0",
            "G1",
            "G2",
            "G3",
            "G4"
          ]
        },
        "status": {
          "const": "APPROVED"
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "gate_id",
        "status",
        "event_hash"
      ],
      "additionalProperties": false
    },
    "confirmed_abandoned": {
      "type": "boolean"
    },
    "initialization": {
      "type": "object",
      "required": [
        "project_id",
        "created_at",
        "engine_version",
        "workspace_root",
        "plan_path",
        "plan_sha256",
        "event_ledger_path",
        "workflow_ledger_path",
        "source_roots",
        "source_artifacts",
        "stage_order",
        "integrity_scope"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "engine_version": {
          "type": "string"
        },
        "workspace_root": {
          "type": "string"
        },
        "plan_path": {
          "const": "run_plan.json"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_ledger_path": {
          "const": "run_events.jsonl"
        },
        "workflow_ledger_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "path",
              "sha256"
            ],
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "stage_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "integrity_scope": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "artifactSnapshot": {
      "type": "object",
      "required": [
        "artifact_id",
        "path",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "WORKER_AUTHORIZED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "attempt",
          "authorized_by",
          "rationale",
          "worker",
          "input_artifacts",
          "permitted_outputs",
          "task_spec",
          "gate_approval"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "STAGE_STATUS"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "status",
          "attempt",
          "producer",
          "input_artifacts",
          "output_artifacts",
          "gate_approval"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "RUN_INITIALIZED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "initialization"
        ]
      }
    }
  ]
}

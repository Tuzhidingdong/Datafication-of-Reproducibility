{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/run_plan.schema.json",
  "title": "DOR Run Plan",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_roots",
    "source_artifacts",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "workflow_ledger_path": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "depends_on",
          "inputs",
          "outputs",
          "executor"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "required_gate": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4",
              null
            ]
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "artifact_id",
                "path"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "derived",
                    "worker_staging"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "executor": {
            "enum": [
              "local",
              "worker",
              "manual"
            ]
          },
          "activation": {
            "type": "object",
            "required": [
              "artifact_id",
              "json_pointer",
              "operator"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "json_pointer": {
                "type": "string",
                "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
              },
              "operator": {
                "enum": [
                  "exists",
                  "not_exists",
                  "array_non_empty",
                  "array_empty",
                  "boolean_true",
                  "boolean_false",
                  "equals",
                  "not_equals"
                ]
              },
              "value": {}
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {
                      "enum": [
                        "equals",
                        "not_equals"
                      ]
                    }
                  },
                  "required": [
                    "operator"
                  ]
                },
                "then": {
                  "required": [
                    "value"
                  ]
                }
              }
            ]
          },
          "worker_task": {
            "type": "object",
            "required": [
              "objective",
              "permitted_actions"
            ],
            "properties": {
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "permitted_actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "forbidden_actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "max_context_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "max_output_tokens": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "executor": {
                  "const": "worker"
                }
              },
              "required": [
                "executor"
              ]
            },
            "then": {
              "required": [
                "worker_task"
              ]
            }
          }
        ]
      }
    },
    "execution_profile": {
      "type": "string",
      "enum": [
        "FULL_ANALYSIS",
        "CONTROLLED_SINGLE_STUDY"
      ],
      "description": "Optional operating profile. Omission defaults to FULL_ANALYSIS; CONTROLLED_SINGLE_STUDY is permitted only with a matching profile-specific Run Plan stage graph."
    }
  },
  "additionalProperties": false
}

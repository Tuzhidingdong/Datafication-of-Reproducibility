{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/reviewed_findings.schema.json",
  "title": "Human-reviewed Worker Findings and Promotion Record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "reviewer",
    "reviewed_at",
    "worker_output",
    "reviewed_artifacts",
    "findings",
    "promotion_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "worker_output": {
      "type": "object",
      "required": [
        "artifact_id",
        "path",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "const": "worker_review_output"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "worker_finding_id",
          "disposition",
          "reviewer_rationale",
          "supporting_artifact_ids"
        ],
        "properties": {
          "worker_finding_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "ACCEPT_AS_IS",
              "ACCEPT_WITH_CHANGES",
              "REJECT",
              "DEFER"
            ]
          },
          "reviewer_rationale": {
            "type": "string",
            "minLength": 1
          },
          "revised_finding_summary": {
            "type": "string",
            "minLength": 1
          },
          "supporting_artifact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "ACCEPT_WITH_CHANGES"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "revised_finding_summary"
              ]
            }
          }
        ]
      }
    },
    "promotion_decision": {
      "enum": [
        "PROMOTE_ACCEPTED_ONLY",
        "PROMOTE_WITH_CHANGES",
        "DO_NOT_PROMOTE",
        "DEFER"
      ]
    },
    "overall_rationale": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

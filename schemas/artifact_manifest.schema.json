{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/artifact_manifest.schema.json",
  "title": "DOR Regenerable Artifact Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "workspace_root",
    "generated_at",
    "event_count",
    "last_event_hash",
    "artifact_count",
    "status_counts",
    "source_integrity",
    "artifacts",
    "source_of_truth",
    "source_roots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 1
    },
    "status_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "source_integrity": {
      "enum": [
        "CURRENT",
        "SOURCE_CHANGED_NEW_RUN_REQUIRED"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "kind",
          "producer_stage_id",
          "path",
          "expected_sha256",
          "actual_sha256",
          "last_successful_attempt",
          "producer_event_hash",
          "status"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "source",
              "derived",
              "worker_staging"
            ]
          },
          "producer_stage_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "expected_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "actual_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "last_successful_attempt": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "producer_event_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "CURRENT",
              "SOURCE_CHANGED_OR_MISSING",
              "STALE_OR_MISSING",
              "PRESENT_UNRECORDED",
              "NOT_CREATED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "source_of_truth": {
      "const": "RUN_PLAN_SOURCE_SNAPSHOTS_AND_HASH_CHAINED_RUN_EVENTS; THIS_MANIFEST_IS_A_REGENERABLE_VIEW"
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

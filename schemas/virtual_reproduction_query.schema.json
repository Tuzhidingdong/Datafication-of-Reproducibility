{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/virtual_reproduction_query.schema.json",
  "title": "Virtual reproduction condition query",
  "type": "object",
  "required": ["schema_version", "task_id", "target_id", "endpoint_definition", "features"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "endpoint_definition": {"type": "string", "minLength": 1},
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit"],
        "properties": {
          "value": {"type": ["number", "string"]},
          "unit": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

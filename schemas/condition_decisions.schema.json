{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/condition_decisions.schema.json",
  "title": "Human-reviewed recovered experimental condition decisions",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_sha256",
    "recovery_validation_sha256",
    "reviewed_by",
    "reviewed_at",
    "main_text_reviewed",
    "si_review_status",
    "reviewed_source_files",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "recovery_validation_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "main_text_reviewed": {
      "type": "boolean"
    },
    "si_review_status": {
      "enum": [
        "REVIEWED",
        "NOT_AVAILABLE_CONFIRMED",
        "NOT_CHECKED"
      ]
    },
    "reviewed_source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "review_scope"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "review_scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "condition_type",
          "condition_instance_id",
          "decision",
          "linked_observation_ids",
          "rationale"
        ],
        "properties": {
          "condition_type": {
            "type": "string",
            "minLength": 1
          },
          "condition_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "REPORTED",
              "NOT_REPORTED",
              "AMBIGUOUS",
              "NOT_ASSESSED"
            ]
          },
          "linked_observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

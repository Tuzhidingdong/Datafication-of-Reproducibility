{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/adapter_handoff.schema.json",
  "title": "DoR Validated Adapter Handoff",
  "description": "A domain-neutral routing record generated by DoR after validating an external adapter package.",
  "type": "object",
  "required": [
    "schema_version",
    "valid",
    "route",
    "package_id",
    "package_root",
    "manifest_path",
    "manifest_sha256",
    "sources",
    "artifacts",
    "standardized_datasets",
    "canonical_bundle",
    "warnings",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "valid": {
      "const": true
    },
    "route": {
      "enum": [
        "STRUCTURED_DATASET",
        "CANONICAL_BUNDLE"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object"
    },
    "package_root": {
      "type": "string",
      "minLength": 1
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "handoff_path": {
      "type": "string"
    },
    "handoff_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "standardized_datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "canonical_bundle": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation_boundary": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "path",
        "package_path",
        "format",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "package_path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "role",
        "path",
        "package_path",
        "format",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "package_path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "validation": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}

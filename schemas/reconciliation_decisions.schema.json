{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/reconciliation_decisions.schema.json","title":"Human reconciliation decisions","type":"object","required":["schema_version","reconciliation_report_sha256","decisions"],"properties":{"schema_version":{"const":"1.0"},"reconciliation_report_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}}},"additionalProperties":false,"$defs":{"decision":{"type":"object","required":["issue_id","decision","reviewer","reviewed_at","rationale"],"properties":{"issue_id":{"type":"string"},"decision":{"enum":["CONFIRMED_DISTINCT","CONFIRMED_CONFLICT","RESOLVED_WITH_EVIDENCE","EXCLUDE_FROM_ANALYSIS","REMAINS_UNRESOLVED"]},"reviewer":{"type":"string","minLength":1},"reviewed_at":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1},"evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"allOf":[{"if":{"properties":{"decision":{"const":"RESOLVED_WITH_EVIDENCE"}},"required":["decision"]},"then":{"required":["evidence_refs"],"properties":{"evidence_refs":{"minItems":1}}}}],"additionalProperties":false}}}
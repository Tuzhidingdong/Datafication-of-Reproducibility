{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/adapter_package.schema.json",
  "title": "DoR External Adapter Package",
  "description": "A domain-neutral handoff contract for data produced by an independently maintained adapter.",
  "type": "object",
  "required": ["schema_version", "package_id", "adapter", "sources", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "required": ["adapter_id", "adapter_version"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "adapter_digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "path", "sha256", "format"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "format": {"enum": ["csv", "json", "jsonl", "tsv", "xml", "text", "binary", "other"]},
          "role": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "role", "path", "sha256", "format"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "role": {
            "enum": [
              "standardized_dataset",
              "discovery_dataset",
              "source_inventory",
              "mapping_plan",
              "build_spec",
              "canonical_bundle",
              "domain_profile",
              "evidence_index",
              "auxiliary"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "format": {"enum": ["csv", "json", "jsonl", "tsv", "xml", "text", "binary", "other"]},
          "media_type": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
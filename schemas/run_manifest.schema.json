{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/run_manifest.schema.json",
  "title": "DOR Run Manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "project_id", "created_at", "engine_version", "workspace_root", "plan_path", "plan_sha256", "event_ledger_path", "source_roots", "source_artifacts", "stage_order", "integrity_scope"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "engine_version": {"type": "string", "minLength": 1},
    "workspace_root": {"type": "string", "minLength": 1},
    "plan_path": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_ledger_path": {"type": "string", "minLength": 1},
    "workflow_ledger_path": {"type": ["string", "null"]},
    "source_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "acceptance_source_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "role", "path", "sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["PRIMARY_PAPER", "SUPPLEMENTARY_INFORMATION", "STRUCTURED_DATA", "OTHER"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      },
      "description": "Immutable provenance-only source snapshot for V1.0 Acceptance; original paper/SI contents are never read."
    },
    "stage_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "integrity_scope": {"type": "string"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/run_review_packet.schema.json",
  "title": "Human Review Packet for a Run Gate",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "stage_id",
    "prepared_at",
    "packet_status",
    "artifact_bindings",
    "review_items",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "enum": [
        "g0_review_packet",
        "g1_review_packet",
        "g2_review_packet"
      ]
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "packet_status": {
      "const": "AWAITING_HUMAN_REVIEW"
    },
    "artifact_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "review_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "question",
          "artifact_ids",
          "mandatory"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mandatory": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preparation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/v1_source_selection_manifest.schema.json",
  "title": "V1.0 Source Selection Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "selection_rationale",
    "scope_statement",
    "study_ids",
    "selected_sources",
    "excluded_sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "selection_rationale": {
      "type": "string",
      "minLength": 1
    },
    "scope_statement": {
      "type": "string",
      "minLength": 1
    },
    "study_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "PRIMARY_PAPER",
              "SUPPLEMENTARY_INFORMATION",
              "STRUCTURED_DATA",
              "OTHER"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "excluded_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "role",
          "path",
          "sha256",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

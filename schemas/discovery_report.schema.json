{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/discovery_report.schema.json",
  "title": "Scientific Discovery Scan Report",
  "type": "object",
  "required": [
    "schema_version",
    "discovery_status",
    "research_opportunity_synthesis",
    "novelty_assessment",
    "profile",
    "signals",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "discovery_status": {
      "const": "EXPLORATORY_SIGNALS_ONLY_NOT_ACCEPTED_SCIENTIFIC_FINDINGS"
    },
    "research_opportunity_synthesis": {
      "const": "REQUIRES_AGENT_SCIENTIFIC_REVIEW"
    },
    "novelty_assessment": {
      "const": "REQUIRES_TARGETED_LITERATURE_REVIEW"
    },
    "profile": {
      "type": "object"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_merge_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_brief_file": {
      "type": "string"
    },
    "source_merge_issue_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "agent_brief_signal_selection": {
      "type": "object",
      "description": "Per-category signal counts included in the bounded Agent research brief.",
      "properties": {
        "CROSS_STUDY_DESCRIPTIVE_HETEROGENEITY": {
          "$ref": "#/$defs/briefSignalSelection"
        },
        "CONDITION_COVERAGE_OPPORTUNITY": {
          "$ref": "#/$defs/briefSignalSelection"
        },
        "CO_OBSERVED_FEATURE_PAIR_OPPORTUNITY": {
          "$ref": "#/$defs/briefSignalSelection"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "briefSignalSelection": {
      "type": "object",
      "required": [
        "available",
        "included",
        "omitted"
      ],
      "properties": {
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "included": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}

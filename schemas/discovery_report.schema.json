{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/discovery_report.schema.json",
  "title": "Deterministic scientific discovery report",
  "type": "object",
  "required": [
    "schema_version",
    "input_type",
    "input_bundle_sha256",
    "profile",
    "signal_count",
    "signals",
    "scientific_analysis",
    "research_opportunities_file",
    "research_opportunity_count",
    "evidence_ledger_file",
    "evidence_ledger_row_count",
    "interpretation_boundary",
    "related_opportunity_group_count"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "input_type": {
      "const": "CANONICAL_BUNDLE"
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "profile": {
      "type": "object"
    },
    "signal_count": {
      "type": "integer",
      "minimum": 0
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "signal_type",
          "interpretation_status"
        ],
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "signal_type": {
            "type": "string",
            "minLength": 1
          },
          "interpretation_status": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "scientific_analysis": {
      "type": "object",
      "required": [
        "profile",
        "limitations",
        "analysis_families"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "required": [
            "engine_version",
            "analysis_unit",
            "fdr_method",
            "fdr_alpha",
            "paired_contrast_test_count",
            "numeric_trend_test_count",
            "opportunity_count_written",
            "maximum_levels_per_condition",
            "condition_level_count_total",
            "categorical_level_count_excluded_from_pairwise_screen",
            "between_system_contrast_test_count",
            "within_system_numeric_trend_test_count",
            "between_system_numeric_trend_test_count",
            "between_system_numeric_group_count",
            "between_system_numeric_eligible_study_count",
            "between_system_categorical_pair_count",
            "between_system_categorical_eligible_study_count",
            "opportunity_count_before_mirror_deduplication",
            "mirror_duplicate_opportunity_count",
            "mirror_duplicate_group_count",
            "self_association_exclusion_count",
            "numeric_trend_fdr_test_count",
            "related_opportunity_group_count",
            "semantic_registry"
          ],
          "properties": {
            "maximum_levels_per_condition": {
              "type": "integer",
              "minimum": 2
            },
            "condition_level_count_total": {
              "type": "integer",
              "minimum": 0
            },
            "categorical_level_count_excluded_from_pairwise_screen": {
              "type": "integer",
              "minimum": 0
            },
            "between_system_contrast_test_count": {
              "type": "integer",
              "minimum": 0
            },
            "within_system_numeric_trend_test_count": {
              "type": "integer",
              "minimum": 0
            },
            "between_system_numeric_trend_test_count": {
              "type": "integer",
              "minimum": 0
            },
            "between_system_numeric_group_count": {
              "type": "integer",
              "minimum": 0
            },
            "between_system_numeric_eligible_study_count": {
              "type": "integer",
              "minimum": 0
            },
            "between_system_categorical_pair_count": {
              "type": "integer",
              "minimum": 0
            },
            "between_system_categorical_eligible_study_count": {
              "type": "integer",
              "minimum": 0
            },
            "opportunity_count_before_mirror_deduplication": {
              "type": "integer",
              "minimum": 0
            },
            "mirror_duplicate_opportunity_count": {
              "type": "integer",
              "minimum": 0
            },
            "mirror_duplicate_group_count": {
              "type": "integer",
              "minimum": 0
            },
            "self_association_exclusion_count": {
              "type": "integer",
              "minimum": 0
            },
            "numeric_trend_fdr_test_count": {
              "type": "integer",
              "minimum": 0
            },
            "related_opportunity_group_count": {
              "type": "integer",
              "minimum": 0
            },
            "semantic_registry": {
              "type": "object",
              "required": [
                "status",
                "registry_id",
                "record_count",
                "approved_record_count",
                "applied_record_count",
                "target_record_count",
                "condition_record_count",
                "bundle_modified",
                "source_locators_dereferenced",
                "target_endpoint_record_count"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "NOT_SUPPLIED",
                    "VALIDATED_AND_APPLIED_IN_MEMORY"
                  ]
                },
                "registry_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "record_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "approved_record_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "applied_record_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "target_record_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "condition_record_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "bundle_modified": {
                  "const": false
                },
                "source_locators_dereferenced": {
                  "const": false
                },
                "target_endpoint_record_count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_families": {
          "type": "object",
          "required": [
            "paired_contrast",
            "numeric_trend",
            "between_system_contrast"
          ],
          "properties": {
            "paired_contrast": {
              "type": "string"
            },
            "numeric_trend": {
              "type": "string"
            },
            "between_system_contrast": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "research_opportunities_file": {
      "const": "research_opportunities.json"
    },
    "research_opportunity_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_ledger_file": {
      "const": "evidence_ledger.jsonl"
    },
    "evidence_ledger_row_count": {
      "type": "integer",
      "minimum": 0
    },
    "interpretation_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mirror_duplicate_opportunity_count": {
      "type": "integer",
      "minimum": 0
    },
    "mirror_duplicate_group_count": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_self_association_count": {
      "type": "integer",
      "minimum": 0
    },
    "related_opportunity_group_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "schema_version": "1.3"
}

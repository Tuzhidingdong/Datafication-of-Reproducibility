{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/discovery_report.schema.json",
  "title": "Scientific Discovery Scan Report",
  "type": "object",
  "required": [
    "schema_version",
    "discovery_status",
    "research_opportunity_synthesis",
    "novelty_assessment",
    "profile",
    "signals",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "discovery_status": {
      "const": "EXPLORATORY_SIGNALS_ONLY_NOT_ACCEPTED_SCIENTIFIC_FINDINGS"
    },
    "research_opportunity_synthesis": {
      "const": "REQUIRES_AGENT_SCIENTIFIC_REVIEW"
    },
    "novelty_assessment": {
      "const": "REQUIRES_TARGETED_LITERATURE_REVIEW"
    },
    "profile": {
      "type": "object"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "condition_extraction_summary": {
      "type": "object"
    },
    "condition_performance_analysis": {
      "type": "object",
      "required": [
        "analysis",
        "mapping_status",
        "endpoint_semantics_status",
        "minimum_doi_studies_per_condition_level",
        "numeric_outcome_observation_count",
        "condition_outcome_link_row_count",
        "condition_stratum_row_count",
        "descriptive_contrast_count",
        "hypothesis_candidate_count"
      ],
      "properties": {
        "analysis": { "type": "string" },
        "mapping_status": { "type": "string" },
        "endpoint_semantics_status": { "type": "string" },
        "minimum_doi_studies_per_condition_level": { "type": "integer", "minimum": 2 },
        "numeric_outcome_observation_count": { "type": "integer", "minimum": 0 },
        "condition_outcome_link_row_count": { "type": "integer", "minimum": 0 },
        "condition_stratum_row_count": { "type": "integer", "minimum": 0 },
        "descriptive_contrast_count": { "type": "integer", "minimum": 0 },
        "hypothesis_candidate_count": { "type": "integer", "minimum": 0 }
      }
    },
    "source_merge_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_brief_file": {
      "type": "string"
    },
    "source_merge_issue_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/discovery_report.schema.json",
  "title": "Deterministic scientific discovery report",
  "type": "object",
  "required": [
    "schema_version",
    "input_type",
    "input_bundle_sha256",
    "profile",
    "signal_count",
    "signals",
    "scientific_analysis",
    "research_opportunities_file",
    "research_opportunity_count",
    "evidence_ledger_file",
    "evidence_ledger_row_count",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "input_type": {
      "const": "CANONICAL_BUNDLE"
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "profile": {
      "type": "object"
    },
    "signal_count": {
      "type": "integer",
      "minimum": 0
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "signal_type",
          "interpretation_status"
        ],
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "signal_type": {
            "type": "string",
            "minLength": 1
          },
          "interpretation_status": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "scientific_analysis": {
      "type": "object",
      "required": [
        "profile",
        "limitations",
        "analysis_families"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "required": [
            "engine_version",
            "analysis_unit",
            "fdr_method",
            "fdr_alpha",
            "paired_contrast_test_count",
            "numeric_trend_test_count",
            "opportunity_count_written",
            "maximum_levels_per_condition",
            "condition_level_count_total",
            "categorical_level_count_excluded_from_pairwise_screen"
          ],
          "properties": {
            "maximum_levels_per_condition": {
              "type": "integer",
              "minimum": 2
            },
            "condition_level_count_total": {
              "type": "integer",
              "minimum": 0
            },
            "categorical_level_count_excluded_from_pairwise_screen": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_families": {
          "type": "object",
          "required": [
            "paired_contrast",
            "numeric_trend"
          ],
          "properties": {
            "paired_contrast": {
              "type": "string"
            },
            "numeric_trend": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "research_opportunities_file": {
      "const": "research_opportunities.json"
    },
    "research_opportunity_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_ledger_file": {
      "const": "evidence_ledger.jsonl"
    },
    "evidence_ledger_row_count": {
      "type": "integer",
      "minimum": 0
    },
    "interpretation_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/interaction_discovery_manifest.schema.json",
  "title":"Pairwise interaction discovery run manifest",
  "type":"object",
  "required":["schema_version","task_id","engine_version","input_hashes","output_hashes","fold_count","seed","candidate_pair_count","eligible_pair_count","method","claim_scope","source_policy"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "task_id":{"type":"string"},
    "engine_version":{"type":"string"},
    "input_hashes":{"type":"object","required":["cohort_sha256","cohort_report_sha256","split_manifest_sha256","cohort_manifest_sha256","task_sha256"],"properties":{
      "cohort_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
      "cohort_report_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
      "split_manifest_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
      "cohort_manifest_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
      "task_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
    },"additionalProperties":false},
    "output_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}},
    "fold_count":{"type":"integer","minimum":4},
    "seed":{"type":"integer"},
    "candidate_pair_count":{"type":"integer","minimum":1},
    "eligible_pair_count":{"type":"integer","minimum":0},
    "method":{"const":"NESTED_STUDY_GROUPED_PAIRWISE_BILINEAR_RIDGE_ABLATION"},
    "claim_scope":{"const":"PREDICTIVE_STATISTICAL_INTERACTION_CANDIDATE_NOT_CAUSAL_OR_MECHANISTIC_EVIDENCE"},
    "source_policy":{"type":"string"}
  },
  "additionalProperties":false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/semantic_registry.schema.json",
  "title": "External Canonical Attribute Semantic Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "source_id",
        "source_sha256",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "semantic_metadata": {
      "type": "object",
      "required": [
        "review_status"
      ],
      "properties": {
        "canonical_concept_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "measurement_basis": {
          "type": "string"
        },
        "measurement_context": {
          "type": "string",
          "minLength": 1
        },
        "derivation_type": {
          "enum": [
            "MEASURED",
            "CALCULATED",
            "UNKNOWN"
          ]
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_status": {
          "enum": [
            "APPROVED",
            "PENDING",
            "REJECTED",
            "UNREVIEWED"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1
        },
        "review_rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "review_status"
            ]
          },
          "then": {
            "required": [
              "canonical_concept_id",
              "reviewer",
              "reviewed_at",
              "review_rationale",
              "source_refs"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "entity_type",
        "canonical_identifier",
        "semantic_metadata"
      ],
      "properties": {
        "entity_type": {
          "enum": [
            "TARGET",
            "TARGET_ENDPOINT",
            "CONDITION"
          ]
        },
        "canonical_identifier": {
          "type": "string",
          "minLength": 1
        },
        "semantic_metadata": {
          "$ref": "#/$defs/semantic_metadata"
        },
        "endpoint_definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "timepoint": {
          "type": [
            "string",
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_type": {
                "const": "TARGET_ENDPOINT"
              }
            },
            "required": [
              "entity_type"
            ]
          },
          "then": {
            "required": [
              "endpoint_definition",
              "timepoint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "entity_type": {
                "enum": [
                  "TARGET",
                  "CONDITION"
                ]
              }
            },
            "required": [
              "entity_type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "endpoint_definition"
                  ]
                },
                {
                  "required": [
                    "timepoint"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}

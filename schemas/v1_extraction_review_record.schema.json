{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/blob/main/schemas/v1_extraction_review_record.schema.json",
  "title": "V1.0 Structured Extraction Review Record",
  "type": "object",
  "required": ["schema_version", "source_hashes", "reviewed_locators", "human_review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "reviewed_locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "locator_type", "locator", "review_status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator_type": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "review_status": {
            "enum": [
              "STRUCTURED_RECORD_REVIEWED",
              "UPSTREAM_EXTRACTION_UNVERIFIED",
              "REVIEW_REQUIRED",
              "NOT_APPLICABLE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "human_review": {
      "type": "object",
      "required": ["reviewer", "reviewed_at", "decision"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "decision": {
          "enum": ["ACCEPTED_WITH_LIMITATIONS", "REJECTED", "REQUIRES_FOLLOW_UP"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/reconciliation_report.schema.json","title":"Non-destructive reconciliation report","type":"object","required":["schema_version","bundle_sha256","valid_bundle","issue_count","issues","decision_policy","validation_scope"],"properties":{"schema_version":{"const":"1.0"},"bundle_sha256":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"},"valid_bundle":{"type":"boolean"},"validation_error_count":{"type":"integer","minimum":0},"validation_warning_count":{"type":"integer","minimum":0},"issue_count":{"type":"integer","minimum":0},"severity_counts":{"type":"object","properties":{"CRITICAL":{"type":"integer"},"REVIEW_REQUIRED":{"type":"integer"},"WARNING":{"type":"integer"},"INFO":{"type":"integer"}},"additionalProperties":false},"issues":{"type":"array","items":{"$ref":"#/$defs/issue"}},"decision_policy":{"const":"HUMAN_REVIEW_ONLY_NO_CANONICAL_DATA_MUTATION"},"validation_scope":{"const":"DETERMINISTIC_CANDIDATE_DETECTION_NOT_SCIENTIFIC_RECONCILIATION"}},"additionalProperties":false,"$defs":{"issue":{"type":"object","required":["issue_id","category","severity","status","entity_type","entity_refs","evidence_refs","summary","review_question","context"],"properties":{"issue_id":{"type":"string","pattern":"^REC_[A-F0-9]{20}$"},"category":{"type":"string"},"severity":{"enum":["CRITICAL","REVIEW_REQUIRED","WARNING","INFO"]},"status":{"const":"OPEN"},"entity_type":{"type":"string"},"entity_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"summary":{"type":"string"},"review_question":{"type":"string"},"context":{"type":"object"}},"additionalProperties":false}}}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/workflow_gate_event.schema.json",
  "title": "Hash-bound workflow gate event (one JSONL ledger line)",
  "type": "object",
  "required": [
    "schema_version",
    "sequence",
    "gate_id",
    "decision",
    "reviewer",
    "reviewed_at",
    "rationale",
    "artifacts",
    "depends_on_event_hash",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "gate_id": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4"
      ]
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REVISE",
        "STOP"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "depends_on_event_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}

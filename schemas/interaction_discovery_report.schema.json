{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/interaction_discovery_report.schema.json",
  "title":"Nested Study-held-out pairwise predictive interaction screen",
  "type":"object",
  "required":["schema_version","task_id","target_id","endpoint_definition","outcome_type","method","statistic_definition","fold_count","study_count","observation_count","candidate_pair_count","eligible_pair_count","excluded_pair_count","exclusions","fold_protocol","interaction_catalogue","interpretation_limits","validation_scope"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "task_id":{"type":"string","minLength":1},
    "target_id":{"type":"string","minLength":1},
    "endpoint_definition":{"type":"string","minLength":1},
    "outcome_type":{"const":"NUMERIC"},
    "method":{"const":"NESTED_STUDY_GROUPED_PAIRWISE_BILINEAR_RIDGE_ABLATION"},
    "statistic_definition":{"type":"string"},
    "fold_count":{"type":"integer","minimum":4},
    "study_count":{"type":"integer","minimum":4},
    "observation_count":{"type":"integer","minimum":1},
    "candidate_pair_count":{"type":"integer","minimum":1},
    "eligible_pair_count":{"type":"integer","minimum":0},
    "excluded_pair_count":{"type":"integer","minimum":0},
    "minimum_joint_observations":{"type":"integer","minimum":2},
    "minimum_joint_studies":{"type":"integer","minimum":2},
    "minimum_positive_fold_fraction":{"type":"number","exclusiveMinimum":0,"maximum":1},
    "fold_protocol":{"type":"array","minItems":4,"items":{"type":"object"}},
    "interaction_catalogue":{"type":"array","items":{"type":"object","required":["feature_a","feature_b","interaction_id","joint_coverage","fold_count","positive_improvement_folds","positive_improvement_fold_fraction","mean_fold_rmse_improvement","study_count_evaluated","positive_improvement_studies","positive_improvement_study_fraction","per_fold","per_study","interpretation_status","claim_scope"],"properties":{
      "feature_a":{"type":"string"},"feature_b":{"type":"string"},"interaction_id":{"type":"string"},
      "joint_coverage":{"type":"object"},"fold_count":{"type":"integer","minimum":1},
      "positive_improvement_folds":{"type":"integer","minimum":0},
      "positive_improvement_fold_fraction":{"type":"number","minimum":0,"maximum":1},
      "mean_fold_rmse_improvement":{"type":["number","null"]},
      "study_count_evaluated":{"type":"integer","minimum":1},
      "positive_improvement_studies":{"type":"integer","minimum":0},
      "positive_improvement_study_fraction":{"type":"number","minimum":0,"maximum":1},
      "per_fold":{"type":"array","items":{"type":"object"}},
      "per_study":{"type":"array","items":{"type":"object"}},
      "interpretation_status":{"enum":["CROSS_STUDY_PREDICTIVE_INTERACTION_CANDIDATE","NOT_STABLE_OR_NO_INCREMENTAL_GAIN","INSUFFICIENT_JOINT_SUPPORT"]},
      "claim_scope":{"type":"string"}
    },"additionalProperties":true}},
    "exclusions":{"type":"array","items":{"type":"object"}},
    "interpretation_limits":{"type":"array","items":{"type":"string"}},
    "validation_scope":{"const":"NESTED_STUDY_HELD_OUT_PREDICTIVE_PAIR_SCREEN_NOT_CAUSAL_INFERENCE_OR_PROSPECTIVE_VALIDATION"}
  },
  "additionalProperties":true
}

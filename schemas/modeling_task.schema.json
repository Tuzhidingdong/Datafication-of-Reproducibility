{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/modeling_task.schema.json",
  "title":"Endpoint-specific modeling task",
  "type":"object",
  "required":["schema_version","task_id","target_id","endpoint_definition","outcome_type","outcome_value_field","outcome_unit","feature_bindings","split"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "task_id":{"type":"string","minLength":1},
    "target_id":{"type":"string","minLength":1},
    "endpoint_definition":{"type":"string","minLength":1,"description":"Exact canonical endpoint_definition match. No fuzzy matching."},
    "outcome_type":{"enum":["NUMERIC","CATEGORICAL"]},
    "outcome_value_field":{"enum":["raw_value","normalized_value"]},
    "outcome_unit":{"type":["string","null"],"description":"Exact required unit, or null for explicitly unitless values."},
    "feature_bindings":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/featureBinding"}},
    "split":{"$ref":"#/$defs/split"},
    "notes":{"type":"string"}
  },
  "additionalProperties":false,
  "$defs":{
    "featureBinding":{
      "type":"object",
      "required":["feature_id","condition_type","value_field","value_type","expected_unit"],
      "properties":{
        "feature_id":{"type":"string","minLength":1},
        "condition_type":{"type":"string","minLength":1,"description":"Exact canonical Condition.condition_type match."},
        "value_field":{"enum":["raw_value","normalized_value"]},
        "value_type":{"enum":["NUMERIC","CATEGORICAL"]},
        "expected_unit":{"type":["string","null"],"description":"Exact required unit; no conversion is performed by the cohort builder."}
      },
      "additionalProperties":false
    },
    "split":{
      "type":"object",
      "required":["strategy"],
      "properties":{
        "strategy":{"enum":["GROUPED_HOLDOUT","EXPLICIT_STUDIES"]},
        "seed":{"type":"integer","default":42},
        "fractions":{
          "type":"object","required":["train","validation","test"],
          "properties":{
            "train":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
            "validation":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
            "test":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1}
          },"additionalProperties":false
        },
        "validation_study_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "test_study_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      },
      "allOf":[
        {"if":{"properties":{"strategy":{"const":"GROUPED_HOLDOUT"}},"required":["strategy"]},"then":{"required":["fractions"]}},
        {"if":{"properties":{"strategy":{"const":"EXPLICIT_STUDIES"}},"required":["strategy"]},"then":{"required":["validation_study_ids","test_study_ids"]}}
      ],
      "additionalProperties":false
    }
  }
}

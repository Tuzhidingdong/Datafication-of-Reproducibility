{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/research_opportunities.schema.json",
  "title": "DOR-generated research opportunity catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "input_bundle_sha256",
    "candidate_count_before_limit",
    "candidate_count_written",
    "opportunities",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "candidate_count_before_limit": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count_written": {
      "type": "integer",
      "minimum": 0
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "research_opportunity.schema.json"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_self_associations": {
      "type": "array",
      "description": "Structural target-condition self-relations excluded before inferential tests and FDR correction.",
      "items": {
        "type": "object",
        "required": [
          "exclusion_id",
          "exclusion_reason",
          "target_id",
          "condition_type",
          "independent_study_count",
          "admission_status"
        ],
        "properties": {
          "exclusion_id": {
            "type": "string",
            "minLength": 1
          },
          "exclusion_reason": {
            "enum": [
              "SAME_CANONICAL_ATTRIBUTE",
              "IDENTICAL_VALUES",
              "SAME_APPROVED_SEMANTIC_CONCEPT",
              "DECLARED_DIRECT_DERIVATION"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "endpoint_definition": {
            "type": "string"
          },
          "timepoint": {
            "type": "string"
          },
          "outcome_unit": {
            "type": "string"
          },
          "condition_type": {
            "type": "string"
          },
          "condition_unit": {
            "type": "string"
          },
          "independent_study_count": {
            "type": "integer",
            "minimum": 0
          },
          "system_count": {
            "type": "integer",
            "minimum": 0
          },
          "experiment_count": {
            "type": "integer",
            "minimum": 0
          },
          "observation_count": {
            "type": "integer",
            "minimum": 0
          },
          "analysis_families_excluded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "admission_status": {
            "const": "EXCLUDED_FROM_SCIENTIFIC_OPPORTUNITIES_AND_FDR"
          }
        },
        "additionalProperties": false
      }
    },
    "mirror_duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mirror_group_id",
          "representative_opportunity_id",
          "duplicate_opportunity_ids",
          "proof",
          "decision"
        ],
        "properties": {
          "mirror_group_id": {
            "type": "string"
          },
          "representative_opportunity_id": {
            "type": "string"
          },
          "duplicate_opportunity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "member_opportunity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attribute_pair": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof": {
            "type": "object",
            "required": [
              "exact_reciprocal_values",
              "identical_study_support",
              "identical_system_support_within_each_study",
              "identical_experiment_support_within_each_system",
              "unit_strings_cross_match_exactly"
            ],
            "properties": {
              "exact_reciprocal_values": {
                "const": true
              },
              "identical_study_support": {
                "const": true
              },
              "identical_system_support_within_each_study": {
                "const": true
              },
              "identical_experiment_support_within_each_system": {
                "const": true
              },
              "unit_strings_cross_match_exactly": {
                "const": true
              },
              "supporting_study_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matched_system_count": {
                "type": "integer",
                "minimum": 0
              },
              "matched_experiment_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "decision": {
            "const": "ONE_STATISTICAL_HYPOTHESIS_RETAINED_BEFORE_BH_FDR"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

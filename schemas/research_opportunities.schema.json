{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/research_opportunities.schema.json",
  "title": "DOR-generated research opportunity catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "input_bundle_sha256",
    "candidate_count_before_limit",
    "candidate_count_written",
    "opportunities",
    "limitations",
    "related_opportunity_groups"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "candidate_count_before_limit": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count_written": {
      "type": "integer",
      "minimum": 0
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "research_opportunity.schema.json"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_self_associations": {
      "type": "array",
      "description": "Structural target-condition self-relations excluded before inferential tests and FDR correction.",
      "items": {
        "type": "object",
        "required": [
          "exclusion_id",
          "exclusion_reason",
          "target_id",
          "condition_type",
          "independent_study_count",
          "admission_status"
        ],
        "properties": {
          "exclusion_id": {
            "type": "string",
            "minLength": 1
          },
          "exclusion_reason": {
            "enum": [
              "SAME_CANONICAL_ATTRIBUTE",
              "IDENTICAL_VALUES",
              "SAME_APPROVED_SEMANTIC_CONCEPT",
              "DECLARED_DIRECT_DERIVATION"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "endpoint_definition": {
            "type": "string"
          },
          "timepoint": {
            "type": "string"
          },
          "outcome_unit": {
            "type": "string"
          },
          "condition_type": {
            "type": "string"
          },
          "condition_unit": {
            "type": "string"
          },
          "independent_study_count": {
            "type": "integer",
            "minimum": 0
          },
          "system_count": {
            "type": "integer",
            "minimum": 0
          },
          "experiment_count": {
            "type": "integer",
            "minimum": 0
          },
          "observation_count": {
            "type": "integer",
            "minimum": 0
          },
          "analysis_families_excluded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "admission_status": {
            "const": "EXCLUDED_FROM_SCIENTIFIC_OPPORTUNITIES_AND_FDR"
          },
          "semantic_review": {
            "type": "object",
            "required": [
              "status",
              "relationship_status",
              "target",
              "condition",
              "interpretation"
            ],
            "properties": {
              "status": {
                "enum": [
                  "APPROVED_METADATA_AVAILABLE_FOR_DOMAIN_REVIEW",
                  "DOMAIN_SEMANTIC_REVIEW_REQUIRED"
                ]
              },
              "relationship_status": {
                "enum": [
                  "DISTINCT_APPROVED_CONCEPTS",
                  "SAME_APPROVED_CONCEPT",
                  "UNRESOLVED_FROM_AVAILABLE_METADATA",
                  "SAME_APPROVED_CONCEPT_SAME_MEASUREMENT_CONTEXT",
                  "SAME_APPROVED_CONCEPT_CONTEXT_UNRESOLVED"
                ]
              },
              "target": {
                "type": "object",
                "required": [
                  "identifier",
                  "status"
                ],
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "MISSING",
                      "PARTIAL",
                      "CONFLICTING",
                      "UNAPPROVED",
                      "APPROVED"
                    ]
                  },
                  "canonical_concept_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "display_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "definition": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "measurement_basis": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "derivation_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "derived_from": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reviewer": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reviewed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "measurement_context": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "condition": {
                "type": "object",
                "required": [
                  "identifier",
                  "status"
                ],
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "MISSING",
                      "PARTIAL",
                      "CONFLICTING",
                      "UNAPPROVED",
                      "APPROVED"
                    ]
                  },
                  "canonical_concept_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "display_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "definition": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "measurement_basis": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "derivation_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "derived_from": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reviewer": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reviewed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "measurement_context": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "interpretation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "mirror_duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mirror_group_id",
          "representative_opportunity_id",
          "duplicate_opportunity_ids",
          "proof",
          "decision"
        ],
        "properties": {
          "mirror_group_id": {
            "type": "string"
          },
          "representative_opportunity_id": {
            "type": "string"
          },
          "duplicate_opportunity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "member_opportunity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attribute_pair": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof": {
            "type": "object",
            "required": [
              "exact_reciprocal_values",
              "identical_study_support",
              "identical_system_support_within_each_study",
              "identical_experiment_support_within_each_system",
              "unit_strings_cross_match_exactly"
            ],
            "properties": {
              "exact_reciprocal_values": {
                "const": true
              },
              "identical_study_support": {
                "const": true
              },
              "identical_system_support_within_each_study": {
                "const": true
              },
              "identical_experiment_support_within_each_system": {
                "const": true
              },
              "unit_strings_cross_match_exactly": {
                "const": true
              },
              "supporting_study_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matched_system_count": {
                "type": "integer",
                "minimum": 0
              },
              "matched_experiment_count": {
                "type": "integer",
                "minimum": 0
              },
              "matched_observation_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "decision": {
            "const": "ONE_STATISTICAL_HYPOTHESIS_RETAINED_BEFORE_BH_FDR"
          }
        },
        "additionalProperties": false
      }
    },
    "related_opportunity_groups": {
      "type": "array",
      "description": "Proven exact reciprocal data patterns retained as distinct hypotheses when endpoint or timepoint context differs.",
      "items": {
        "type": "object",
        "required": [
          "related_group_id",
          "relationship_type",
          "member_opportunity_ids",
          "members",
          "proof",
          "review_status",
          "decision",
          "statistical_action"
        ],
        "properties": {
          "related_group_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship_type": {
            "const": "RECIPROCAL_DATA_PATTERN_CONTEXT_VARIANT"
          },
          "member_opportunity_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "opportunity_id",
                "target_id",
                "condition_type",
                "endpoint_definition",
                "timepoint",
                "outcome_unit",
                "condition_unit",
                "p_value",
                "q_value"
              ],
              "properties": {
                "opportunity_id": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string"
                },
                "condition_type": {
                  "type": "string"
                },
                "endpoint_definition": {
                  "type": "string"
                },
                "timepoint": {
                  "type": "string"
                },
                "outcome_unit": {
                  "type": "string"
                },
                "condition_unit": {
                  "type": "string"
                },
                "p_value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "q_value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "proof": {
            "type": "object",
            "required": [
              "exact_reciprocal_values",
              "identical_study_support",
              "identical_system_support_within_each_study",
              "identical_experiment_support_within_each_system",
              "unit_strings_cross_match_exactly",
              "same_endpoint_definition",
              "same_timepoint",
              "context_dimensions_differ",
              "supporting_study_ids",
              "matched_system_count",
              "matched_experiment_count",
              "matched_observation_count"
            ],
            "properties": {
              "exact_reciprocal_values": {
                "const": true
              },
              "identical_study_support": {
                "const": true
              },
              "identical_system_support_within_each_study": {
                "const": true
              },
              "identical_experiment_support_within_each_system": {
                "const": true
              },
              "unit_strings_cross_match_exactly": {
                "const": true
              },
              "same_endpoint_definition": {
                "type": "boolean"
              },
              "same_timepoint": {
                "type": "boolean"
              },
              "context_dimensions_differ": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "endpoint_definition",
                    "timepoint"
                  ]
                }
              },
              "supporting_study_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matched_system_count": {
                "type": "integer",
                "minimum": 0
              },
              "matched_experiment_count": {
                "type": "integer",
                "minimum": 0
              },
              "matched_observation_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "review_status": {
            "const": "REQUIRES_DOMAIN_REVIEW"
          },
          "decision": {
            "const": "KEEP_ALL_MEMBERS_AS_DISTINCT_HYPOTHESES"
          },
          "statistical_action": {
            "const": "NO_DEDUPLICATION_NO_FDR_CHANGE"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

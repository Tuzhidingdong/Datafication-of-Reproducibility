{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Datafication-of-Reproducibility/schemas/single_study_applicability_record.schema.json",
  "title": "Controlled single-Study applicability review record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "scope",
    "applicability_status",
    "study_ids",
    "study_count",
    "canonical_bundle_sha256",
    "modeling_task_sha256",
    "cohort_feasibility_status",
    "cohort_feasibility_reason",
    "modeling_validation_status",
    "modeling_validation_reason",
    "reviewer",
    "reviewed_at",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "CONTROLLED_SINGLE_STUDY"
    },
    "applicability_status": {
      "const": "NOT_APPLICABLE"
    },
    "study_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "study_count": {
      "const": 1
    },
    "canonical_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modeling_task_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cohort_feasibility_status": {
      "const": "NOT_APPLICABLE"
    },
    "cohort_feasibility_reason": {
      "type": "string",
      "minLength": 1
    },
    "modeling_validation_status": {
      "const": "NOT_APPLICABLE"
    },
    "modeling_validation_reason": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

          "artifact_id": "worker_review_output",
          "path": "worker_staging/independent_result_review/review.json",
          "kind": "worker_staging"
        }
      ],
      "required_gate": "G3",
      "worker_task": {
        "objective": "Independently review the controlled single-Study scope, exact source-to-canonical provenance, reconciliation decisions, and the explicit NOT_APPLICABLE boundaries. Confirm that exactly one eligible Study supports the declared scope; that no model, cross-Study reproducibility, interaction, mechanism, or virtual-prediction result is being claimed; and that the publication hand-off preserves the limitations. Report any unsupported claim or provenance gap. Do not fabricate analyses or infer source-document contents.",
        "permitted_actions": [
          "Read only the declared structured JSON artifacts and compact reports; original papers/SI and other raw assets are opaque provenance-only files and must never be opened.",
          "Inspect applicability_status, reasons, exact IDs, hashes, reconciliation decisions, warnings, and limitations before detailed report sections.",
          "Write one structured review JSON to the exact permitted staging path.",
          "Use stable unique finding_id values and cite supporting_artifact_ids with exact JSON-path evidence locators.",
          "Conform to schemas/worker_result.schema.json and templates/worker_result.example.json."
        ],
        "forbidden_actions": [
          "Fit or rerun models, calculate predictive metrics, or fabricate model/prediction/interaction outputs.",
          "Split rows or observations into pseudo-independent Studies.",
          "Read, parse, render, OCR, index, search, summarize, or send original papers/SI to an LLM or Worker.",
          "Modify source data, Canonical Bundle, reconciliation decisions, or approval records.",
          "Approve G0-G4 or promote Worker findings."
        ],
        "max_context_tokens": 14000,
        "max_output_tokens": 3000
      }
    },

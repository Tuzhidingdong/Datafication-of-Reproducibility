        "model_report",
        "reproducibility_evaluation",
        "interaction_report",
        "robustness_report",
        "interaction_selection",
        "virtual_prediction"
      ],
      "worker_task": {
        "objective": "Independently audit the declared model, reproducibility, interaction, robustness, selection, and virtual-prediction reports for leakage, unsupported scientific claims, contradictory evidence, and reproducibility risks.",
        "permitted_actions": [
          "Read only the six declared compact JSON/report inputs",
          "Write one structured review JSON to the exact permitted staging path",
          "Cite exact artifact IDs and JSON paths for each finding"
        ],
        "forbidden_actions": [
          "Modify source data or analysis artifacts",
          "Rerun models or calculations",
          "Change G3 interaction selection",
          "Approve a G0-G4 workflow gate",
          "Promote Worker output into approved scientific results"
        ],
        "max_context_tokens": 18000,
        "max_output_tokens": 3500
      },
      "outputs": [
        {
          "artifact_id": "worker_review_output",
          "path": "worker_staging/independent_result_review/review.json",
          "kind": "worker_staging"
